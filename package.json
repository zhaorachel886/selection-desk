{
  "name": "selection-desk",
  "version": "0.2.0-alpha.2",
  "private": true,
  "author": "zhaorachel886",
  "license": "MIT",
  "description": "拾句：Windows 划词翻译与 AI 助手",
  "main": "dist/main/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "package": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:desktop": "node scripts/smoke.mjs",
    "notices": "node scripts/notices.mjs",
    "release:checksums": "node scripts/release-checksums.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "selection-hook": "2.1.2"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "electron": "45.0.0",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.10",
    "playwright": "1.56.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "io.selectiondesk.desktop",
    "productName": "拾句",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "assets/licenses/**/*"
    ],
    "asarUnpack": [
      "node_modules/selection-hook/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/branding/shiju.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "Shiju-Setup-${version}-${arch}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "shortcutName": "拾句",
      "installerIcon": "assets/branding/shiju.ico",
      "uninstallerIcon": "assets/branding/shiju.ico"
    },
    "portable": {
      "artifactName": "Shiju-${version}-${arch}.exe"
    }
  }
}
